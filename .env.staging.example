# Prefer SELECT-only MySQL credentials; no FTP, SMTP or production JWT secrets.
# Set true only after operator approval to reuse an externally protected account.
STAGING_ERP_ALLOW_EXISTING_CREDENTIALS=false
HOST_DB_MYSQL=
USER_MYSQL=
PASSWORD_MYSQL=
DATABASE_MYSQL=
INTERNAL_API_KEY=replace-with-staging-erp-internal-key
